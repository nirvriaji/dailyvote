rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Votos anónimos por dispositivo
    match /votes/{deviceId} {
      allow read, write: if true;
    }
    
    // Estadísticas globales (solo lectura pública)
    match /globalStats/{date} {
      allow read: if true;
      allow write: if false;
    }
    
    // Resultados diarios agregados
    match /dailyResults/{date} {
      allow read: if true;
      allow write: if false;
    }
  }
}
