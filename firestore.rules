rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Votos anónimos por dispositivo
    match /votes/{deviceId} {
      allow read, write: if true;
    }
    
    // Estadísticas globales (lectura/escritura pública para simulador)
    match /globalStats/{date} {
      allow read, write: if true;
    }
    
    // Resultados diarios agregados (lectura/escritura pública para simulador)
    match /dailyResults/{date} {
      allow read, write: if true;
    }
  }
}
