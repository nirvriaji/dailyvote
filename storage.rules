rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files under /images/
    match /images/{allPaths=**} {
      allow read: if true;
    }
    
    // Allow write access only to authenticated users (for the migration script)
    match /images/{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
